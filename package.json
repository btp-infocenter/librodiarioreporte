{
  "name": "librodiarioreporte",
  "version": "0.0.1",
  "description": "",
  "keywords": [
    "ui5",
    "openui5",
    "sapui5"
  ],
  "main": "webapp/index.html",
  "dependencies": {},
  "devDependencies": {
    "@ui5/cli": "^4.0.16",
    "@sap/ux-ui5-tooling": "1",
    "@sap-ux/ui5-middleware-fe-mockserver": "2",
    "ui5-task-zipper": "^3.4.x",
    "rimraf": "^5.0.5",
    "mbt": "^1.2.29"
  },
  "scripts": {
    "start": "NODE_OPTIONS=--dns-result-order=ipv4first fiori run --open \"test/flp.html#app-preview\"",
    "start-local": "NODE_OPTIONS=--dns-result-order=ipv4first fiori run --config ./ui5-local.yaml --open \"test/flp.html#app-preview\"",
    "build": "ui5 build --config=ui5.yaml --clean-dest --dest dist",
    "start-mock": "NODE_OPTIONS=--dns-result-order=ipv4first fiori run --config ./ui5-mock.yaml --open \"test/flp.html#app-preview\"",
    "deploy": "fiori cfDeploy",
    "deploy-config": "fiori add deploy-config",
    "start-noflp": "NODE_OPTIONS=--dns-result-order=ipv4first fiori run --open \"index.html?sap-ui-xx-viewCache=false\"",
    "int-test": "NODE_OPTIONS=--dns-result-order=ipv4first fiori run --config ./ui5-mock.yaml --open \"test/integration/opaTests.qunit.html\"",
    "start-variants-management": "NODE_OPTIONS=--dns-result-order=ipv4first fiori run --open \"preview.html#app-preview\"",
    "build:cf": "ui5 build preload --clean-dest --config ui5-deploy.yaml --include-task=generateCachebusterInfo",
    "build:mta": "rimraf resources mta_archives && mbt build",
    "undeploy": "cf undeploy infoinfocenterlibrodiarioreporte --delete-services --delete-service-keys --delete-service-brokers"
  },
  "sapuxLayer": "CUSTOMER_BASE",
  "sapux": true
}
